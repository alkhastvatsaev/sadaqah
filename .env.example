# Public browser configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Canonical application origin (no trailing slash)
APP_URL=http://localhost:3000

# Stripe server credentials
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Operator protection (generate each with: openssl rand -hex 32)
ADMIN_API_KEY=replace_with_at_least_32_random_characters
CONNECT_LINK_SECRET=replace_with_at_least_32_random_characters

# Firebase Admin service account (never use NEXT_PUBLIC_ prefixes)
FIREBASE_PROJECT_ID=replace_me
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# Resend
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Sadaqah <notifications@example.com>
REGISTRATION_TO_EMAIL=operator@example.com
